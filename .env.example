# Create a HubSpot private app with the content scope.
# Keep the token local; never commit it or paste it into the dashboard.
HUBSPOT_ACCESS_TOKEN=
# Optional: sync only this HubSpot blog (contentGroupId).
HUBSPOT_BLOG_ID=
# Relative paths are resolved against this project folder.
DATABASE_PATH=data/migration.db
PORT=8000

# WordPress site root URL (HTTPS), including any installation subdirectory.
# Dedicated application password from Users > Profile.
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
